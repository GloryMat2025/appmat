## Copy this file to .env and fill values for local testing or Docker.
# VAPID keys (generate using repo script)
VAPID_PUBLIC_KEY=BLANK_PUBLIC_KEY_PASTE_HERE
VAPID_PRIVATE_KEY=BLANK_PRIVATE_KEY_PASTE_HERE

# Optional token to protect the relay. Set this and configure Supabase to send it.
RELAY_TOKEN=super-secret-token

# Port (default 4000)
PORT=4000

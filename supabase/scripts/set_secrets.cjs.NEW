// Consolidated secrets setter for Supabase project
// Reads `supabase/.env.local` and sets secrets via `npx supabase secrets set`.
const fs = require('fs');
const cp = require('child_process');

const envPath = 'supabase/.env.local';
if (!fs.existsSync(envPath)) {
  console.error('env file missing:', envPath);
  process.exit(1);
}

const raw = fs.readFileSync(envPath, 'utf8');

function extract(key) {
  const re = new RegExp('^' + key + "\\s*=\\s*(.*)$", 'm');
  const m = raw.match(re);
  if (!m) return '';
  return m[1].trim().replace(/^\"|\"$/g, '').replace(/^'|'$/g, '');
}

const service = extract('SUPABASE_SERVICE_ROLE_KEY') || extract('SERVICE_ROLE_KEY') || '';
const fcm = extract('FCM_SERVER_KEY') || '';
const adminToken = extract('ADMIN_TEST_TOKEN') || '';
const vapidPub = extract('VAPID_PUBLIC_KEY') || '';
const vapidPriv = extract('VAPID_PRIVATE_KEY') || '';
const pushRelay = extract('PUSH_RELAY_URL') || '';

if (!service) {
  console.error('No SUPABASE_SERVICE_ROLE_KEY or SERVICE_ROLE_KEY found in', envPath);
  process.exit(2);
}

console.log('Setting Supabase secrets for project ref qtoiurlefwodxjcichgz...');

const args = [];
function quote(v){ return '"' + String(v).replace(/"/g, '\\"') + '"'; }
args.push('SUPABASE_SERVICE_ROLE_KEY=' + quote(service));
if (fcm) args.push('FCM_SERVER_KEY=' + quote(fcm));
if (adminToken) args.push('ADMIN_TEST_TOKEN=' + quote(adminToken));
if (vapidPub) args.push('VAPID_PUBLIC_KEY=' + quote(vapidPub));
if (vapidPriv) args.push('VAPID_PRIVATE_KEY=' + quote(vapidPriv));
if (pushRelay) args.push('PUSH_RELAY_URL=' + quote(pushRelay));

const cmd = `npx supabase secrets set --project-ref qtoiurlefwodxjcichgz ${args.join(' ')}`;
try {
  console.log('Running:', cmd.replace(/\s+SUPABASE_SERVICE_ROLE_KEY=.*$/,' SUPABASE_SERVICE_ROLE_KEY=***'));
  cp.execSync(cmd, { stdio: 'inherit' });
  console.log('Secrets set.');
} catch (err) {
  console.error('Failed to set secrets:', err && err.message ? err.message : String(err));
  process.exit(3);
}

# Keep the script idempotent and quiet when done.

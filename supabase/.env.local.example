# Supabase local environment template
# Copy to supabase/.env.local and fill values. Do NOT commit secrets.

SUPABASE_URL=https://<proj>.supabase.co
# Prefer SERVICE_ROLE_KEY for server-side operations
SERVICE_ROLE_KEY=replace-with-service-role-key
# Optional: SERVICE_ROLE_KEY alternative name the CLI may accept
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# VAPID keys for Web Push
VAPID_PUBLIC_KEY=replace-with-vapid-public
VAPID_PRIVATE_KEY=replace-with-vapid-private

# Optional Postgres connection (use only for local testing)
# DATABASE_URL=postgresql://user:password@host:5432/database

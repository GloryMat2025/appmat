 supabase/scripts/rotate_and_validate.cjs | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/supabase/scripts/rotate_and_validate.cjs b/supabase/scripts/rotate_and_validate.cjs
index 4ce926a3..558f99f6 100644
--- a/supabase/scripts/rotate_and_validate.cjs

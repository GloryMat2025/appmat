Date: Tue, 25 Nov 2025 10:42:29 +0800
Subject: [PATCH 23/34] chore(supabase): fix duplicate declaration in
 decode-secret helper

---
 supabase/fix-decode-secret.patch | 52 ++++++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)
 create mode 100644 supabase/fix-decode-secret.patch

diff --git a/supabase/fix-decode-secret.patch b/supabase/fix-decode-secret.patch
new file mode 100644
index 00000000..af9b611d
--- /dev/null
+++ b/supabase/fix-decode-secret.patch
@@ -0,0 +1,52 @@
+type NUL > fix-decode-secret.patch
+powershell -Command "Set-Content -Path fix-decode-secret.patch -Value @'
+*** Begin Patch
+*** Update File: supabase/scripts/decode-secret.js
+@@
+-// previous contents had duplicate declarations causing a parse error
+-
+-// (replaced by canonical implementation below)
++/**
++ * Helper utilities to decode environment values that may be base64-encoded.
++ *
++ * Usage:
++ *  - `tryDecodeEnvBase64('MY_SECRET')` will:
++ *     1) prefer `process.env['MY_SECRET_B64']` and decode it as base64, if present
++ *     2) otherwise return `process.env['MY_SECRET']` (string) or `undefined`
++ *
++ *  - `decodeEnvBase64('MY_SECRET')` will throw if there is no value.
++ */
++
++function tryDecodeEnvBase64(name) {
++  const b64Name = `${name}_B64`;
++  if (Object.prototype.hasOwnProperty.call(process.env, b64Name) && process.env[b64Name] != null) {
++    const raw = process.env[b64Name];
++    try {
++      const decoded = Buffer.from(raw, 'base64').toString('utf8');
++      return decoded;
++    } catch (err) {
++      return raw;
++    }
++  }
++
++  if (Object.prototype.hasOwnProperty.call(process.env, name) && process.env[name] != null) {
++    return process.env[name];
++  }
++
++  return undefined;
++}
++
++function decodeEnvBase64(name) {
++  const val = tryDecodeEnvBase64(name);
++  if (val === undefined) {
++    throw new Error(`Environment variable \"${name}\" not found (searched ${name} and ${name}_B64)`);
++  }
++  return val;
++}
++
++module.exports = {
++  tryDecodeEnvBase64,
++  decodeEnvBase64,
++};
+*** End Patch
+'@"

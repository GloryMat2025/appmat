+import { getAdminOrderDetail, updateOrderStatus } from "@/services/adminOrders";
+import StatusBadge from "@/ui/StatusBadge";
+
+const STATUS_FLOW = [
+  "pending",
+  "paid",
+  "preparing",
+  "delivering",
+  "completed",
+  "cancelled",
+];
+
+await fetch(`${import.meta.env.VITE_PUSH_ENDPOINT}/order-status`, {
+  method: "POST",
+  headers: { "Content-Type": "application/json" },
+  body: JSON.stringify({ order_id: orderId, status }),
+});
+
+const AdminOrderDetailPage = () => {
+  const { id } = useParams<{ id: string }>();
+
+  const [order, setOrder] = useState<any>(null);
+  const [loading, setLoading] = useState(true);
+  const [newStatus, setNewStatus] = useState("");
+
+  async function loadDetail() {
+    setLoading(true);
+    try {
+      const data = await getAdminOrderDetail(id);
+      setOrder(data);
+      setNewStatus(data.status);
+    } catch (err) {
+      console.error(err);
+      alert("Failed to load order detail (Admin)");
+    }
+    setLoading(false);
+  }
+
+  async function submitStatus() {
+    if (!newStatus) return;
+
+    try {
+      const res = await updateOrderStatus(id, newStatus);
+
+      alert("Status updated!");
+
+      // reload again
+      loadDetail();
+    } catch (err) {
+      console.error(err);
+      alert("Failed to update order.");
+    }
+  }
+
+  useEffect(() => {
+    loadDetail();
+  }, [id]);
+
+  if (loading || !order) {
+    return (
+      <IonPage>
+        <IonContent className="admin-loading">
+          <IonSpinner name="crescent" />
+        </IonContent>
+      </IonPage>
+    );
+  }
+
+  return (

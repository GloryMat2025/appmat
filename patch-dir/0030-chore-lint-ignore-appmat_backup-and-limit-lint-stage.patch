+            <h2>Total</h2>
+            <div className="admin-total-row">
+              <span>Total Amount</span>
+              <strong>RM {order.total.toFixed(2)}</strong>
+            </div>
+          </IonCardContent>
+        </IonCard>
+      </IonContent>
+    </IonPage>
+  );
+};
+
+export default AdminOrderDetailPage;

 2 files changed, 101 insertions(+)
 create mode 100644 supabase/scripts/check-secrets.js
 create mode 100644 upabasesecrets.json.template

diff --git a/supabase/scripts/check-secrets.js b/supabase/scripts/check-secrets.js
new file mode 100644
index 00000000..8468a94d
--- /dev/null
+++ b/supabase/scripts/check-secrets.js
@@ -0,0 +1,11 @@
+const fs = require('fs');
+const d = JSON.parse(fs.readFileSync('supabase/secrets.json', 'utf8'));
+Object.entries(d).forEach(([k, v]) => {
+  const s = String(v);
+  const issues = [];
+  if (/\r|\n/.test(s)) issues.push('newline');
+  if (/`/.test(s)) issues.push('backtick');
+  if (/["']/.test(s)) issues.push('quote');
+  if (/^\s|\s$/.test(s)) issues.push('leading/trailing-space');
+  if (issues.length) console.log(k + ': ' + issues.join(', '));
+});

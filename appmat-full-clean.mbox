{link.path} className=\"hover:underline\">\n            {link.name}\n          </Link>\n        ))}\n\n        {/* Cart */}\n        <Link to=\"/cart\" className=\"relative\">\n          🛒\n          {cartItems.length > 0 && (\n            <span className=\"absolute -top-2 -right-2 bg-yellow-400 text-xs text-black rounded-full px-2 py-0.5\">\n              {cartItems.length}\n            </span>\n          )}\n        </Link>\n\n        {/* Dark mode toggle */}\n        <button\n          onClick={toggleTheme}\n          className=\"ml-4 bg-yellow-400 text-black px-2 py-1 rounded-full hover:bg-yellow-300 transition\"\n          title=\"Toggle theme\"\n        >\n          {theme === 'dark' ? '🌙' : '☀️'}\n        </button>\n      </div>\n\n      {/* Mobile hamburger */}\n      <button\n        onClick={() => setMenuOpen(!menuOpen)}\n        className=\"md:hidden bg-yellow-400 text-black px-2 py-1 rounded-full\"\n        aria-label=\"Toggle menu\"\n      >\n        ☰\n      </button>\n\n      {/* Mobile dropdown */}\n      {menuOpen && (\n        <div className=\"absolute top-16 right-4 bg-white dark:bg-gray-800 text-black dark:text-white p-4 rounded shadow-md md:hidden space-y-2 z-50\">\n          {links.map((link) => (\n            <Link\n              key={link.name}\n              to={link.path}\n              onClick={() => setMenuOpen(false)}\n              className=\"block hover:underline\"\n            >\n              {link.name}\n            </Link>\n          ))}\n          <button\n            onClick={toggleTheme}\n            className=\"block w-full bg-yellow-400 text-black py-1 rounded\"\n          >\n            {theme === 'dark' ? '🌙' : '☀️'}\n          </button>\n        </div>\n      )}\n    </nav>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DESIGNER 1\\Desktop\\appmat\\src\\components\\OfflineStatus.jsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'React' is defined but never used.","line":1
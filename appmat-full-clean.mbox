d.","line":5,"column":34,"nodeType":null,"messageId":"unusedVar","endLine":5,"endColumn":48},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'err' is defined but never used.","line":52,"column":14,"nodeType":null,"messageId":"unusedVar","endLine":52,"endColumn":17}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport useCart from '../hooks/useCart';\n\nexport default function Checkout() {\n  const { cartItems, totalPrice, removeFromCart, clearCart } = useCart();\n  const [form, setForm] = useState({ name: '', phone: '', address: '' });\n  const [submitting, setSubmitting] = useState(false);\n\n  const handleChange = (e) => setForm({ ...form, [e.target.name]: e.target.value });\n\n  const handleSubmit = async (e) => {\n    e.preventDefault();\n    if (cartItems.length === 0) {\n      alert('Troli anda kosong. Tambah produk dahulu!');\n      return;\n    }\n\n    const order = {\n      name: form.name,\n      phone: form.phone,\n      address: form.address,\n      items: cartItems,\n      total: totalPrice,\n    };\n\n    setSubmitting(true);\n    try {\n      const res = await fetch('/api/orders', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(order),\n      });\n\n      if (!res.ok) throw new Error('Server error');\n      alert('✅ Order sent successfully!');\n\n      // Send a follow-up notification to the server (used for push/notification UI)\n      try {\n        await fetch('/api/notify', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({\n            title: 'AppMat Update',\n            body: '✅ Pesanan anda telah berjaya disinkronkan!',\n            url: '/orders',\n          }),\n        });\n      } catch (notifyErr) {\n        // Non-fatal — log and continue\n        console.warn('Notify failed', notifyErr);\n      }\n    } catch (err) {\n      alert('⚠️ Offline mode: Order will be sent automatically later.');\n      // Ask SW to sync later\n      if ('serviceWorker' in navigator && 'SyncManager' in window) {\n        const reg = await navigator.serviceWorker.ready;\n        await reg.sync.register('sync-orders');\n        console.log('📡 Sync registered for later.');\n      }\n    } finally {\n      setSubmitting(false);\n    }\n  };\n\n  return (\n    <section id=\"checkout\" className=\"py-12 px-4 bg-gray-50 dark:bg-gray-900 min-h-screen\">\n      <div className=\"max-w-3xl mx-auto bg-white dark:bg-gray-800 rounded-lg shadow-md p-6\">\n        <h2 className=\"text-2xl font-bold mb-4 text-blue-700 dark:text-yellow-400\">Checkout</h2>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div>\n            <label className=\"block text-sm font-medium\">Nama</label>\n            <input\n              name=\"name\"\n              value={form.name}\n              onChange={handleChange}\n              className=\"mt-1 block w-full border rounded px-3 py-2\"\n              required\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-sm font-medium\">Telefon</label>\n            <input\n              name=\"phone\"\n              value={form.phone}\n              onChange={handleChange}\n              className=\"mt-1 block w-full border rounded px-3 py-2\"\n              required\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-sm font-medium\">Alamat</label>\n            <textarea\n              name=\"address\"\n              value={form.address}\n              onChange={handleChange}\n              className=\"mt-1 block w-full border rounded px-3 py-2\"\n              required\n            />\n          </div>\n\n          <div className=\"border-t pt-4\">\n            <h3 className=\"font-semibold\">Ringkasan Pesanan</h3>\n            <ul className=\"mt-2 space-y-2\">\n              {cartItems.map((it) => (\n                <li key={it.id} className=\"flex justify-between\">\n                  <span>\n                    {it.title} x {it.quantity}\n                  </span>\n                  <span>RM {(it.price * it.quantity).toFixed(2)}</span>\n                </li>\n              ))}\n            </ul>\n            <div className=\"text-right mt-4\">\n              <strong>Jumlah: RM {totalPrice.toFixed(2)}</strong>\n            </div>\n          </div>\n\n          <div className=\"flex justify-between items-center\">\n            <button\n              type=\"submit\"\n              disabled={submitting}\n              className=\"bg-blue-600 text-white px-4 py-2 rounded\"\n            >\n              {submitting ? 'Memproses...' : 'Hantar Pesanan'}\n            </button>\n            <button type=\"button\" onClick={clearCart} className=\"text-sm text-red-600\">\n              Kosongkan Troli\n            </button>\n          </div>\n        </form>\n      </div>\n    </section>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DESIGNER 1\\Desktop\\appmat\\src\\components\\Features.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DESIGNER 1\\Desktop\\appmat\\src\\components\\Footer.jsx","messages":[{"ruleId":"react-hooks/rules-of-hooks","message":"Definition for rule 'react-hooks/rules-of-hooks' was not found.","line":1,"column":1,"endLine":1,"endColumn":48,"severity":2,"nodeType":null},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'motion' is defined but never used.","line":2,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":2,"endColumn":16}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/* eslint-dis
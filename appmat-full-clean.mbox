+$lblCI.AutoSize = $true
+$form.Controls.Add($lblCI)
+
+# Buttons
+$buttons = @(
+  @{t="Verify Setup"; y=150; f="./verify-fix-package.ps1"},
+  @{t="Run Orchestrator"; y=150; x=230; f="./auto-fix-orchestrator.ps1"},

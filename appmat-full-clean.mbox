-    "source": "import React, { useEffect, useState } from 'react';\nimport '../styles/offline.css';\n\nOfflineStatus.propTypes = {\n  // TODO: define props here (auto added)\n};\n\nexport default function OfflineStatus() {\n  const [isOffline, setIsOffline] = useState(!navigator.onLine);\n  const [seconds, setSeconds] = useState(5);\n\n  useEffect(() => {\n    const handleOffline = () => setIsOffline(true);\n    const handleOnline = () => setIsOffline(false);\n\n    window.addEventListener('offline', handleOffline);\n    window.addEventListener('online', handleOnline);\n\n    return () => {\n      window.removeEventListener('offline', handleOffline);\n      window.removeEventListener('online', handleOnline);\n    };\n  }, []);\n\n  // Auto-retry every few seconds\n  useEffect(() => {\n    if (!isOffline) return;\n    const interval = setInterval(() => {\n      setSeconds((prev) => (prev > 1 ? prev - 1 : 5));\n      if (navigator.onLine) {\n        setIsOffline(false);\n      }\n    }, 1000);\n    return () => clearInterval(interval);\n  }, [isOffline]);\n\n  const tryReconnect = () => {\n    if (navigator.onLine) {\n      setIsOffline(false);\n    } else {\n      setSeconds(5);\n      setTimeout(() => {\n        if (navigator.onLine) setIsOffline(false);\n      }, 1000);\n    }\n  };\n\n  if (!isOffline) return null;\n\n  return (\n    <div className=\"offline-banner\">\n      <p>ΓÜá∩╕Å YouΓÇÖre offline ΓÇö checking again in {seconds}s...</p>\n      <button className=\"retry-btn\" onClick={tryReconnect}>\n        Try Reconnect\n      </button>\n    </div>\n  );\n}\n",
